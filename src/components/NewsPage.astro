---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getAnnouncements } from '@utils/announcements';
import { render } from 'astro:content';

interface Props {
  lang?: 'en' | 'ja';
}

const { lang = 'en' } = Astro.props;
const labels = site.announcements.labels[lang];
const announcements = await getAnnouncements(lang);

const rendered = await Promise.all(
  announcements.map(async (item) => ({ item, rendered: await render(item) })),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Page lang={lang} title={labels.title} description={labels.description}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {lang === 'ja' ? site.languages.japanese.news : site.navbar.newsLabel}
      </h1>
    </header>
    <article>
      {
        rendered.length === 0 ? (
          <p style="color: var(--global-text-color-light);">{labels.empty}</p>
        ) : (
          <table style="width: 100%; border-collapse: collapse;">
            <tbody>
              {rendered.map(({ item, rendered: { Content } }) => (
                <tr style="border-bottom: 1px solid var(--global-divider-color);">
                  <td style="padding: 0.5rem 1rem 0.5rem 0; white-space: nowrap; vertical-align: top; color: var(--global-text-color-light); font-size: 0.8rem;">
                    {formatDate(item.data.date)}
                  </td>
                  <td style="padding: 0.5rem 0; font-size: 0.9rem; color: var(--global-text-color);">
                    <Content />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </article>
  </div>
</Page>

<style>
  .post-header {
    margin-bottom: 1.5rem;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--global-text-color);
    font-family: var(--font-sans);
    margin-bottom: 0;
  }
</style>
