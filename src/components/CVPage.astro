---
import CVEntry from '@components/cv/CVEntry.astro';
import CVSection from '@components/cv/CVSection.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import type { JSONResume, RenderCV, RenderCVEntry } from '@utils/cv';
import { formatCVDate as formatDate, formatDateRange as formatRange } from '@utils/cv';
import yaml from 'js-yaml';

import IconFilePdf from '~icons/fa-solid/file-pdf';

import cvRawJa from '../data/cv.ja.yml?raw';
import cvRawEn from '../data/cv.yml?raw';
import resumeData from '../data/resume.json';

interface Props {
  lang?: 'en' | 'ja';
}

const { lang = 'en' } = Astro.props;
const japanese = lang === 'ja' && site.cv.localized;
const labels = japanese ? site.cv.japaneseLabels : site.cv.labels;
const cvRaw = japanese ? cvRawJa : cvRawEn;
const format = japanese ? 'rendercv' : site.cv.format;
const dateOptions = { locale: japanese ? 'ja-JP' : 'en-US', presentLabel: labels.present };
const formatCVDate = (value: string | number | undefined) => formatDate(value, dateOptions);
const formatDateRange = (start: string | number | undefined, end: string | number | undefined) =>
  formatRange(start, end, dateOptions);

const renderCV = format === 'rendercv' ? (yaml.load(cvRaw) as RenderCV) : null;
const jsonResume = format === 'jsonresume' ? (resumeData as JSONResume) : null;

const rc = renderCV?.cv ?? null;
const label = site.cv.showLabel ? rc?.label : undefined;
const education = (rc?.sections?.education ?? []) as RenderCVEntry[];
const work = (rc?.sections?.work ?? []) as RenderCVEntry[];
const fellowships = site.cv.showFellowships ? (rc?.sections?.fellowships ?? []) : [];
const languages = site.cv.showLanguages ? (rc?.languages ?? []) : [];
const rcPublications = (rc?.sections?.publications ?? []) as RenderCVEntry[];
const awards = (rc?.sections?.awards ?? []) as RenderCVEntry[];
const skills = (rc?.sections?.skills ?? []) as RenderCVEntry[];
const interests = (rc?.sections?.interests ?? []) as RenderCVEntry[];

const jr = jsonResume ?? null;
const jrLabel = jr?.basics?.label ?? '';

// Build sidebar TOC items based on which sections have data
type TocItem = { label: string; href: string };

const tocItems: TocItem[] = [];
if (format === 'rendercv' && rc) {
  if (rc.name || label || rc.email || rc.phone || rc.website || rc.location || languages.length > 0)
    tocItems.push({ label: labels.basics, href: '#contact' });
  if (rc.summary) tocItems.push({ label: labels.summary, href: '#summary' });
  if (education.length > 0) tocItems.push({ label: labels.education, href: '#education' });
  if (work.length > 0) tocItems.push({ label: labels.work, href: '#work' });
  if (fellowships.length > 0) tocItems.push({ label: labels.fellowships, href: '#fellowships' });
  if (rcPublications.length > 0)
    tocItems.push({ label: labels.publications, href: '#publications' });
  if (awards.length > 0) tocItems.push({ label: labels.awards, href: '#awards' });
  if (skills.length > 0) tocItems.push({ label: labels.skills, href: '#skills' });
  if (interests.length > 0) tocItems.push({ label: labels.interests, href: '#interests' });
} else if (format === 'jsonresume' && jr) {
  if (jr.basics) tocItems.push({ label: labels.basics, href: '#contact' });
  if (jr.work?.length) tocItems.push({ label: labels.work, href: '#work' });
  if (jr.education?.length) tocItems.push({ label: labels.education, href: '#education' });
  if (jr.publications?.length) tocItems.push({ label: labels.publications, href: '#publications' });
  if (jr.awards?.length) tocItems.push({ label: labels.awards, href: '#awards' });
  if (jr.skills?.length) tocItems.push({ label: labels.skills, href: '#skills' });
  if (jr.languages?.length) tocItems.push({ label: labels.languages, href: '#languages' });
  if (jr.interests?.length) tocItems.push({ label: labels.interests, href: '#interests' });
}
---

<Page lang={lang} title={labels.title} description={labels.description}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {labels.title}
        {
          site.cv.pdfPath && (
            <a
              href={withBase(site.cv.pdfPath)}
              target="_blank"
              rel="noopener noreferrer"
              class="float-right"
              aria-label={labels.download}
            >
              <IconFilePdf />
            </a>
          )
        }
      </h1>
    </header>

    <article>
      <div class="cv-page-wrapper">
        <!-- Sidebar TOC -->
        {
          tocItems.length > 0 && (
            <nav class="cv-sidebar-toc" aria-label={labels.sections}>
              <ul>
                {tocItems.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <!-- CV content -->
        <div class="cv">
          <!-- ── RENDERCV ──────────────────────────────────────────────── -->
          {
            format === 'rendercv' && renderCV && (
              <>
                {rc &&
                  (rc.name ||
                    label ||
                    rc.email ||
                    rc.phone ||
                    rc.website ||
                    rc.location ||
                    languages.length > 0) && (
                    <>
                      <a class="anchor" id="contact" />
                      <div class="card mt-3 p-3">
                        <h3 class="card-title font-weight-medium">{labels.basics}</h3>
                        <table class="table-cv table-sm table-borderless table">
                          {rc.name && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.name}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.name}</td>
                            </tr>
                          )}
                          {label && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.label}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{label}</td>
                            </tr>
                          )}
                          {rc.email && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.email}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.email}</td>
                            </tr>
                          )}
                          {rc.phone && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.phone}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.phone}</td>
                            </tr>
                          )}
                          {rc.location && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.location}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.location}</td>
                            </tr>
                          )}
                          {rc.website && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.website}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">
                                <a href={rc.website} target="_blank" rel="noopener noreferrer">
                                  {rc.website}
                                </a>
                              </td>
                            </tr>
                          )}
                          {languages.length > 0 && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>{labels.languages}</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{languages.join(', ')}</td>
                            </tr>
                          )}
                        </table>
                      </div>
                    </>
                  )}

                {rc?.summary && (
                  <>
                    <a class="anchor" id="summary" />
                    <div class="card mt-3 p-3">
                      <h3 class="card-title font-weight-medium">{labels.summary}</h3>
                      <p class="card-text font-weight-light">{rc.summary}</p>
                    </div>
                  </>
                )}

                {education.length > 0 && (
                  <CVSection title={labels.education} id="education">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {education.map((e) => (
                        <CVEntry
                          title={[e.degree, e.area].filter(Boolean).join(labels.areaSeparator)}
                          subtitle={e.institution}
                          location={e.location}
                          dates={formatDateRange(e.start_date, e.end_date)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {work.length > 0 && (
                  <CVSection title={labels.work} id="work">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {work.map((e) => (
                        <CVEntry
                          title={e.position ?? e.title ?? ''}
                          subtitle={e.company}
                          location={e.location}
                          dates={formatDateRange(e.start_date, e.end_date)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {fellowships.length > 0 && (
                  <CVSection title={labels.fellowships} id="fellowships">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {fellowships.map((e) => (
                        <CVEntry
                          title={e.name ?? e.title ?? ''}
                          subtitle={e.issuer ?? e.institution}
                          location={e.location}
                          dates={
                            e.date !== undefined
                              ? formatCVDate(e.date)
                              : formatDateRange(e.start_date, e.end_date)
                          }
                          highlights={e.highlights}
                          url={e.url}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {rcPublications.length > 0 && (
                  <CVSection title={labels.selectedPublications} id="publications">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {rcPublications.map((e) => (
                        <CVEntry
                          title={e.title ?? ''}
                          subtitle={[e.authors?.join(', '), e.journal].filter(Boolean).join(' — ')}
                          dates={formatCVDate(e.date)}
                          url={e.doi ? `https://doi.org/${e.doi}` : e.url}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {awards.length > 0 && (
                  <CVSection title={labels.honors} id="awards">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {awards.map((e) => (
                        <CVEntry
                          title={e.name ?? ''}
                          subtitle={e.issuer}
                          dates={formatCVDate(e.date)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {skills.length > 0 && (
                  <CVSection title={labels.skills} id="skills">
                    <div class="card-text font-weight-light">
                      {skills.map((e) => (
                        <div class="skill-item">
                          <strong>{e.label}:</strong> {e.details}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}

                {interests.length > 0 && (
                  <CVSection title={labels.interests} id="interests">
                    <div class="card-text font-weight-light">
                      {interests.map((e) => (
                        <div class="skill-item">
                          <strong>{e.label}:</strong> {e.details}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}
              </>
            )
          }

          <!-- ── JSONRESUME ─────────────────────────────────────────────── -->
          {
            format === 'jsonresume' && jsonResume && (
              <>
                {jr?.basics && (
                  <>
                    <a class="anchor" id="contact" />
                    <div class="card mt-3 p-3">
                      <h3 class="card-title font-weight-medium">{labels.basics}</h3>
                      <table class="table-cv table-sm table-borderless table">
                        {jr.basics.name && (
                          <tr>
                            <td class="font-weight-bold p-1 pr-2">
                              <b>{labels.name}</b>
                            </td>
                            <td class="font-weight-light p-1 pl-2">{jr.basics.name}</td>
                          </tr>
                        )}
                        {jrLabel && (
                          <tr>
                            <td class="font-weight-bold p-1 pr-2">
                              <b>Professional Title</b>
                            </td>
                            <td class="font-weight-light p-1 pl-2">{jrLabel}</td>
                          </tr>
                        )}
                        {jr.basics.email && (
                          <tr>
                            <td class="font-weight-bold p-1 pr-2">
                              <b>{labels.email}</b>
                            </td>
                            <td class="font-weight-light p-1 pl-2">{jr.basics.email}</td>
                          </tr>
                        )}
                        {jr.basics.phone && (
                          <tr>
                            <td class="font-weight-bold p-1 pr-2">
                              <b>{labels.phone}</b>
                            </td>
                            <td class="font-weight-light p-1 pl-2">{jr.basics.phone}</td>
                          </tr>
                        )}
                        {jr.basics.url && (
                          <tr>
                            <td class="font-weight-bold p-1 pr-2">
                              <b>{labels.website}</b>
                            </td>
                            <td class="font-weight-light p-1 pl-2">
                              <a href={jr.basics.url} target="_blank" rel="noopener noreferrer">
                                {jr.basics.url}
                              </a>
                            </td>
                          </tr>
                        )}
                      </table>
                    </div>
                  </>
                )}

                {jr?.work && jr.work.length > 0 && (
                  <CVSection title={labels.work} id="work">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.work.map((e) => (
                        <CVEntry
                          title={e.position ?? ''}
                          subtitle={e.name}
                          url={e.url}
                          dates={formatDateRange(e.startDate, e.endDate)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.education && jr.education.length > 0 && (
                  <CVSection title={labels.education} id="education">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.education.map((e) => (
                        <CVEntry
                          title={[e.studyType, e.area].filter(Boolean).join(labels.areaSeparator)}
                          subtitle={e.institution}
                          url={e.url}
                          dates={formatDateRange(e.startDate, e.endDate)}
                          highlights={e.courses}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.publications && jr.publications.length > 0 && (
                  <CVSection title={labels.selectedPublications} id="publications">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.publications.map((e) => (
                        <CVEntry
                          title={e.name ?? ''}
                          subtitle={e.publisher}
                          url={e.url}
                          dates={formatCVDate(e.releaseDate)}
                          highlights={e.summary ? [e.summary] : []}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.awards && jr.awards.length > 0 && (
                  <CVSection title={labels.honors} id="awards">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.awards.map((e) => (
                        <CVEntry
                          title={e.title ?? ''}
                          subtitle={e.awarder}
                          dates={formatCVDate(e.date)}
                          highlights={e.summary ? [e.summary] : []}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.skills && jr.skills.length > 0 && (
                  <CVSection title={labels.skills} id="skills">
                    <div class="card-text font-weight-light">
                      {jr.skills.map((e) => (
                        <div class="skill-item">
                          <strong>{e.name}:</strong> {e.keywords?.join(', ')}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}

                {jr?.languages && jr.languages.length > 0 && (
                  <CVSection title={labels.languages} id="languages">
                    <div class="card-text font-weight-light">
                      {jr.languages.map((e) => (
                        <div class="skill-item">
                          <strong>{e.language}:</strong> {e.fluency}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}

                {jr?.interests && jr.interests.length > 0 && (
                  <CVSection title={labels.interests} id="interests">
                    <div class="card-text font-weight-light">
                      {jr.interests.map((e) => (
                        <div class="skill-item">
                          <strong>{e.name}:</strong> {e.keywords?.join(', ')}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}
              </>
            )
          }
        </div><!-- /.cv -->
      </div><!-- /.cv-page-wrapper -->
    </article>
  </div>
</Page>

<style>
  /* Two-column layout: sidebar + content */
  .cv-page-wrapper {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  /* Sticky left sidebar TOC */
  .cv-sidebar-toc {
    flex-shrink: 0;
    width: 180px;
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .cv-sidebar-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--global-divider-color);
  }

  .cv-sidebar-toc li a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.75rem;
    font-size: 0.8rem;
    color: var(--global-text-color-light);
    text-decoration: none;
    transition: color 0.15s ease;
    line-height: 1.3;
  }

  .cv-sidebar-toc li a:hover {
    color: var(--global-theme-color);
  }

  /* Main CV content fills remaining space */
  .cv {
    flex: 1;
    min-width: 0;
  }

  /* Hide sidebar on small screens */
  @media (max-width: 768px) {
    .cv-page-wrapper {
      flex-direction: column;
    }
    .cv-sidebar-toc {
      display: none;
    }
  }
</style>
