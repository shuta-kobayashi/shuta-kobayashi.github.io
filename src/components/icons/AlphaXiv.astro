---
const { width = '1em', height = '1em', 'aria-hidden': ariaHidden = true, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaHidden}
  {...rest}
>
  <path
    d="M19 6 14 16c-1 2-2.5 3-4.5 3C6 19 4 16 4 12s2-7 5.5-7C13 5 14 8 15 12l1 4c.5 2 1.5 3 3 3h1"
  ></path>
</svg>
